{
  "name": "@webship.co/workspace-phpbb",
  "version": "1.0.2",
  "description": "phpBB for Webship Workspace: the builder (`cmd-phpbb-project.sh`, a board from its release package, installed with its own command-line installer, its default style, served by Apache in containers with a mail catcher, with optional sample content) and the command-line tool in every sites folder, the default accounts, the phpBB step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-phpbb.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "phpbb",
    "label": "phpBB",
    "summary": "A builder for phpBB boards (a forum from its release package, with optional sample content), and its command-line tool",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-phpbb-project.sh",
        "commands/cmd-tools-phpbb-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-phpbb.sh"
      ],
      "args": [
        "scripts/args/arg-phpbb.sh",
        "scripts/args/arg-phpbb-cli.sh"
      ],
      "machine": [
        "scripts/phpbb-site.php",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/phpbb-site-builder.md",
        "ai/agents/phpbb-tester.md"
      ],
      "skills": [
        "ai/skills/phpbb-scenarios"
      ],
      "commands": [
        "ai/commands/phpbb-test.md"
      ],
      "prompts": [
        "ai/prompts/phpbb-build-and-test.md",
        "ai/prompts/phpbb-scenarios-for-an-area.md"
      ]
    },
    "features": [
      "features/phpbb.feature",
      "features/phpbb-runtimes.feature"
    ],
    "featuresSite": "cmd-phpbb-project.sh ci-phpbb --install --add-users --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
